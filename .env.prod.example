# =============================================================================
# token-factory 生产编排（docker-compose.prod.yml）
# 复制为 .env：cp .env.prod.example .env ，填写密码；勿提交 .env
# 与线上 tokease 环境结构一致（2026-06 自 43.132.223.112 同步）
# 访问应用 http://localhost:3020 ；本机连 PostgreSQL 用端口 5434
# =============================================================================
POSTGRES_USER=root
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=token_factory
# 密码含 @ : # 等字符时须设置 SQL_DSN 并对密码 URL 编码（@ -> %40）
# SQL_DSN=postgresql://root:ENCODED_PASSWORD@postgres:5432/token_factory

PORT=3000

SESSION_SECRET=CHANGE_ME_random_string

# ── 路由开关 ──────────────────────────────────────────────────────
# 独立部署（仅跑 token-factory）：保持 false，走原生选路（亲和 → SmartRouter → 优先级/权重）
TOKENFACTORY_ROUTE_ENABLED=false
# 进程内 SmartRouter（router-engine）；默认开启。纯优先级/权重随机时可设 false
# SMART_ROUTER_ENABLED=false

# ── TokenFactory 智能路由（TOKENFACTORY_ROUTE_ENABLED=true 时填写）──
# 与 TokenFactory deploy/.env 中 JWT_SECRET 一致
# TOKENFACTORY_ROUTE_ENABLED=true
# 同机 Docker：经 external 网络连 api 服务名；跨机填宿主机 IP:9000
# TOKENFACTORY_GRPC_ENDPOINT=api:9000
# TOKENFACTORY_JWT_SECRET=CHANGE_ME_same_as_tokenfactory_JWT_SECRET
# TOKENFACTORY_SITE_KEY=tokease
# TOKENFACTORY_ROUTE_STICKY_TTL_SECONDS=1800
# 叠加编排: docker compose -f docker-compose.prod.yml -f docker-compose.prod.tokenfactory.yml up -d
